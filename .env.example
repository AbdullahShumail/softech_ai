# ---- HTTP / public endpoint ----
NODE_ENV=development
HTTP_PORT=8080
# Loopback-only; Caddy proxies to us. Set 0.0.0.0 only if running without a proxy.
BIND_HOST=127.0.0.1
# Public hostname Twilio connects back to for the Media Stream (no protocol).
# Must be reachable over TLS from the internet. e.g. bot.yourdomain.com
PUBLIC_HOST=

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Validate X-Twilio-Signature on inbound webhooks (keep true in prod)
TWILIO_VALIDATE_SIGNATURES=true

# ---- Groq ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
# gpt-oss are reasoning models — low effort + headroom so JSON content is not truncated
GROQ_REASONING_EFFORT=low
GROQ_CLASSIFIER_MAX_TOKENS=400

# ---- Storage ----
DB_PATH=./data/bot.db

# ---- Prompts ----
PROMPT_DIR=./prompts/b2b-outreach

# ---- Transfer ----
CLOSER_NUMBER=

# ---- Dialing policy ----
CALLING_HOUR_START=8
CALLING_HOUR_END=21
MAX_CONCURRENT_CALLS=4
# Start the dialer automatically on boot (false = control via POST /runner/start)
RUNNER_AUTOSTART=false
# Shared secret for GET/POST /runner* control endpoints (X-Control-Token header)
CONTROL_TOKEN=

# ---- Logging ----
LOG_LEVEL=info
