# ---- HTTP / public endpoint ----
NODE_ENV=development
HTTP_PORT=8080
# Public hostname Twilio connects back to for the Media Stream (no protocol).
# Must be reachable over TLS from the internet. e.g. bot.yourdomain.com
PUBLIC_HOST=

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Validate X-Twilio-Signature on inbound webhooks (keep true in prod)
TWILIO_VALIDATE_SIGNATURES=true

# ---- Groq ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.1-8b-instant

# ---- Storage ----
DB_PATH=./data/bot.db

# ---- Prompts ----
PROMPT_DIR=./prompts/b2b-outreach

# ---- Transfer ----
CLOSER_NUMBER=

# ---- Dialing policy ----
CALLING_HOUR_START=8
CALLING_HOUR_END=21
MAX_CONCURRENT_CALLS=4

# ---- Logging ----
LOG_LEVEL=info
